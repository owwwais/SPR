# interview-agent configuration. Every value is a secret except PORT,
# WEBHOOK_URL, ALLOWED_ORIGINS and PLANNER_POLL_MS. None of these belong in
# the repository.

PORT=8080
DATABASE_URL=postgres://user:password@host:5432/interview_agent

# Shared with the platform's interview-gateway Edge Function (INTERVIEW_AGENT_KEYS
# there). Two entries during rotation: k1:<secret>,k2:<secret>. 32+ chars each.
PLATFORM_HMAC_KEYS=k1:replace-with-openssl-rand-hex-32

# The platform's interview-webhook Edge Function, and the secret it verifies
# with (INTERVIEW_WEBHOOK_SECRET there). Different from the key above.
WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/interview-webhook
WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
WEBHOOK_KEY_ID=k1

# Private Ed25519 JWK for candidate session tokens: npm run keygen
SESSION_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","d":"...","x":"...","kid":"session-2026-10-16","alg":"EdDSA"}

# The platform's origin(s), for browser calls to /v1/session
ALLOWED_ORIGINS=https://hakeem.sa

# The model key (CLAUDE.md D3 exception: this server's environment only —
# never the platform's, never the repository). Optional: without it the agent
# serves everything that needs no model and answers 503 llm_not_configured
# to question generation, before creating anything.
GEMINI_API_KEY=

# How often the planner looks for banks and interviews waiting for questions.
PLANNER_POLL_MS=2000
