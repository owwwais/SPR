{
  "name": "interview-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Hakeem virtual first-round interview service (CLAUDE.md D30). Separate server; talks to the platform over an HMAC-signed contract.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bash tests/run.sh",
    "keygen": "node scripts/generate-session-key.ts",
    "contract:sync": "node scripts/sync-contract.ts"
  },
  "dependencies": {
    "@google/genai": "2.25.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "5.9.3"
  }
}
